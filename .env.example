# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SITE_URL: The public production origin used for canonical URLs and sitemap generation.
# On Vercel, VERCEL_PROJECT_PRODUCTION_URL is used automatically when exposed.
# Example: SITE_URL="https://your-game.example.com"
SITE_URL=""

# INDEXNOW_KEY: Keep the same value in the production build and when submitting URLs.
# Generate one with: npm run indexnow:key
INDEXNOW_KEY=""
